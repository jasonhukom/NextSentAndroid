<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whatsapp_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- User Profile Preview Row -->
        <LinearLayout
            android:id="@+id/settingsProfileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/settingsAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="J"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settingsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jason"
                    android:textColor="@color/whatsapp_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settingsAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Available"
                    android:textColor="@color/whatsapp_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACCOUNT Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/whatsapp_bg"
            android:paddingStart="17dp"
            android:paddingTop="17dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:text="ACCOUNT"
            android:textColor="@color/whatsapp_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Setting Row: Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="15dp"
            android:paddingEnd="17dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textColor="@color/whatsapp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Security notifications, change number"
                android:textColor="@color/whatsapp_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/whatsapp_line" />

        <!-- Setting Row: Privacy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="15dp"
            android:paddingEnd="17dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textColor="@color/whatsapp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Last seen, profile photo, status"
                android:textColor="@color/whatsapp_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- PREFERENCES Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/whatsapp_bg"
            android:paddingStart="17dp"
            android:paddingTop="17dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:text="PREFERENCES"
            android:textColor="@color/whatsapp_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Setting Row: Chats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="15dp"
            android:paddingEnd="17dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chats"
                android:textColor="@color/whatsapp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Theme, wallpaper, chat history"
                android:textColor="@color/whatsapp_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/whatsapp_line" />

        <!-- Setting Row: Switch Account -->
        <LinearLayout
            android:id="@+id/rowSwitchAccountSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="15dp"
            android:paddingEnd="17dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch account"
                android:textColor="@color/whatsapp_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jason"
                android:textColor="@color/whatsapp_muted"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
