<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/whatsapp_chat_bg">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/callHead"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_alignParentTop="true"
        android:background="@color/whatsapp_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/buttonEndCallHeader"
            android:layout_width="34dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="NextSent call"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Call Panel -->
    <LinearLayout
        android:id="@+id/callpanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/callHead"
        android:layout_above="@+id/callactions"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/callAvatar"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:gravity="center"
            android:text="@string/question_mark"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Contact"
            android:textColor="@color/whatsapp_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calling…"
            android:textColor="@color/whatsapp_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Call Actions -->
    <LinearLayout
        android:id="@+id/callactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="28dp">

        <ImageButton
            android:id="@+id/buttonSwitchDuringCall"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginEnd="22dp"
            android:background="@color/whatsapp_green"
            android:contentDescription="Switch Account"
            android:src="@android:drawable/ic_menu_rotate" />

        <ImageButton
            android:id="@+id/buttonEndCall"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="#E53935"
            android:contentDescription="End Call"
            android:src="@android:drawable/ic_menu_call" />
    </LinearLayout>

</RelativeLayout>
